# ====================================================================
# PANDUAN ENVIRONMENT VARIABLES UNTUK DEPLOYMENT KE VERCEL
# Masukkan variable berikut ke menu:
# Vercel Dashboard -> Project Anda -> Settings -> Environment Variables
# ====================================================================

# --------------------------------------------------------------------
# 1. KONFIGURASI UTAMA APLIKASI
# --------------------------------------------------------------------
APP_NAME=E-PROKOPIM
APP_ENV=production
APP_KEY=base64:59bgZN3hO3fWIqS/7E1IbZtSx3cc/JR9mdkcI2/QdQk=
APP_DEBUG=false
APP_URL=https://nama-proyek-anda.vercel.app

# --------------------------------------------------------------------
# 2. DATABASE
# OPSI A (BAWAAN OTOMATIS / ZERO-CONFIG):
# Aplikasi sudah dilengkapi file database bawaan (pre-seeded).
# Anda TIDAK PERLU menambahkan variabel database apapun di Vercel jika
# ingin langsung jalan menggunakan SQLite.
#
# OPSI B (JIKA INGIN MENGGUNAKAN CLOUD MYSQL EKSTERNAL):
# Aktifkan variabel di bawah ini jika menggunakan database MySQL online
# (Contoh: TiDB Cloud, Aiven MySQL, Railway, dsb.):
# --------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=host-cloud-db-anda.com
# DB_PORT=3306
# DB_DATABASE=nama_database_anda
# DB_USERNAME=user_database_anda
# DB_PASSWORD=password_database_anda

# --------------------------------------------------------------------
# 3. PENGATURAN SESSION & CACHE SERVERLESS VERCEL
# (Sudah diset otomatis di vercel.json, opsional ditambahkan di dashboard)
# --------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# --------------------------------------------------------------------
# 4. API ASISTEN AI (GEMINI)
# --------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

